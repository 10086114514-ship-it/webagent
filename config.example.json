{
  "_comment": "复制为 config.json 后使用。所有字段均可省略，以 _ 开头的键仅作注释。详见 README.md。",

  "target": {
    "_window_match": "browser=按浏览器进程查找（推荐，换网页/换标题都不用改）；process=按下面 process 的进程名；contains/regex/exact=按 window_title 匹配",
    "window_match": "browser",
    "window_title": "在线测验",
    "process": "",
    "client_area": true,
    "activate": true
  },

  "model": {
    "base_url": "https://api.deepseek.com/v1",
    "api_key": "",
    "api_key_env": "DEEPSEEK_API_KEY",
    "model": "deepseek-chat",
    "vision": false,
    "temperature": 0.0,
    "max_tokens": 2000,
    "timeout_s": 60,
    "mock": false,
    "extra_headers": {},
    "extra_body": {}
  },

  "ocr": {
    "enabled": true,
    "language": "zh-Hans",
    "scale": 1.0
  },

  "agent": {
    "instruction": "",
    "max_steps": 20,
    "step_delay_s": 0.5,
    "cooldown_s": 2.0
  },

  "action": {
    "type_mode": "paste",
    "click_delay_ms": 120,
    "scroll_step": 300
  },

  "runtime": {
    "interval_s": 2.0,
    "hotkey_toggle": "F8",
    "hotkey_once": "F9",
    "hotkey_abort": "ESC",
    "debug_dir": "debug",
    "save_debug": true,
    "log_level": "INFO"
  }
}
